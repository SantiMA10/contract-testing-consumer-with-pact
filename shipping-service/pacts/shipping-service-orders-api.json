{
  "consumer": {
    "name": "shipping-service"
  },
  "interactions": [
    {
      "description": "a request for order shipping details",
      "providerStates": [
        {
          "name": "an order with id 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/orders/1"
      },
      "response": {
        "body": {
          "id": 1,
          "propForShippingService": "Property only for shipping service",
          "shippingAddress": {
            "city": "Madrid",
            "country": "ES",
            "postalCode": "28001",
            "street": "Calle Mayor 1"
          },
          "status": "pending"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.propForShippingService": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.shippingAddress": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "orders-api"
  }
}